// Schéma Prisma pour Preventis - Système de sécurité IoT

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Utilisateurs
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hash bcrypt
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  apiKeys  ApiKey[]
  gateways Gateway[]
  devices  Device[]

  @@map("users")
}

// Clés API pour l'authentification des devices
model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique // Clé API en clair (affichée une seule fois)
  keyHash   String   @unique // Hash pour vérification
  name      String   @default("Default API Key")
  userId    String
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// Gateways (Centrales)
model Gateway {
  id          String   @id @default(uuid())
  name        String   @default("Centrale principale")
  userId      String
  apiKeyId    String?  // Clé API utilisée par cette gateway
  status      GatewayStatus @default(OFFLINE)
  lastSeenAt  DateTime?
  config      String?  @db.Text // JSON: { ip, port, apiKey, deviceIds: [] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@map("gateways")
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  WARNING
}

// Devices (Modules/Capteurs) - Version améliorée avec userId
model Device {
  id          String       @id @default(uuid())
  userId      String       // Propriétaire
  gatewayId   String?      // Gateway associée
  name        String
  type        DeviceType
  location    String
  status      DeviceStatus @default(OFFLINE)
  value       Float        @default(0)
  unit        String       @default("")
  threshold   Float
  batteryLevel Int?
  metadata    String?      @db.Text // JSON pour config supplémentaire
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway Gateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  alerts  Alert[]
  valueHistory DeviceValueHistory[]

  @@map("devices")
}

enum DeviceType {
  SENSOR_CO2
  SENSOR_TEMPERATURE
  SENSOR_INFRARED
  SENSOR_SMOKE
  MODULE_ALARM
  MODULE_GATEWAY
}

// Enum pour le statut des devices (réutilisé)
enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  ALERT
}

// Capteurs (CO2, Infrarouge, Fumée, Température) - Legacy, à migrer vers Device
model Sensor {
  id           String       @id @default(uuid())
  name         String
  type         SensorType
  location     String
  status       SensorStatus @default(ONLINE)
  value        Float        @default(0)
  unit         String       @default("")
  threshold    Float
  batteryLevel Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  zone    Zone?   @relation(fields: [zoneId], references: [id])
  zoneId  String?
  alerts  Alert[]

  @@map("sensors")
}

enum SensorType {
  CO2
  INFRARED
  SMOKE
  TEMPERATURE
}

enum SensorStatus {
  ONLINE
  OFFLINE
  WARNING
  ALERT
}

// Alertes
model Alert {
  id           String     @id @default(uuid())
  type         AlertType
  level        AlertLevel
  title        String
  message      String     @db.Text
  location     String
  acknowledged Boolean    @default(false)
  userId       String?    // Propriétaire de l'alerte
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  sensor   Sensor? @relation(fields: [sensorId], references: [id])
  sensorId String?
  device   Device? @relation(fields: [deviceId], references: [id])
  deviceId String?

  @@map("alerts")
}

enum AlertType {
  FIRE
  INTRUSION
  SYSTEM
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

// Zones de surveillance
model Zone {
  id        String       @id @default(uuid())
  name      String       @unique
  status    SensorStatus @default(ONLINE)
  isArmed   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  sensors Sensor[]

  @@map("zones")
}

// État de l'alarme (singleton)
model AlarmState {
  id          String    @id @default("main")
  isArmed     Boolean   @default(false)
  mode        AlarmMode @default(OFF)
  sirenActive Boolean   @default(false)
  lastArmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("alarm_state")
}

enum AlarmMode {
  OFF
  HOME
  AWAY
  NIGHT
}

// Historique des valeurs des devices
model DeviceValueHistory {
  id        String   @id @default(uuid())
  deviceId  String
  value     Float
  batteryLevel Int?
  status    DeviceStatus
  createdAt DateTime @default(now())

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("device_value_history")
}

// Historique des événements
model EventLog {
  id        String   @id @default(uuid())
  type      String
  message   String
  data      String?  @db.Text
  createdAt DateTime @default(now())

  @@map("event_logs")
}
